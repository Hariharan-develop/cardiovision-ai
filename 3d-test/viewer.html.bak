<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>CardioVision AI | Complete 3D Anatomical Heart Inspector</title>
<style>
  :root { color-scheme: dark; font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #071526; color: #eaf2ff; overflow: hidden; }
  #canvas { width: 100vw; height: 100vh; display: block; }
  
  /* Left Controls Panel */
  .panel {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 10;
    width: min(350px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding: 16px 18px;
    border: 1px solid #233e5c;
    border-radius: 14px;
    background: #0d1e34ea;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
  }
  .panel::-webkit-scrollbar { width: 5px; }
  .panel::-webkit-scrollbar-thumb { background: #2f4d70; border-radius: 3px; }

  h1 { font-size: 16.5px; font-weight: 750; margin: 0 0 2px; color: #ffffff; letter-spacing: -0.2px; }
  .subtitle { color: #8eb3dc; font-size: 11px; margin: 0 0 11px; line-height: 1.35; }
  
  #status {
    font-size: 11.5px;
    font-weight: 600;
    color: #cfe3fd;
    padding: 7px 11px;
    border-radius: 7px;
    background: #142e4d;
    border: 1px solid #24466c;
    margin-bottom: 11px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .spinner {
    width: 12px;
    height: 12px;
    border: 2px solid #548cd1;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .preset-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    margin-bottom: 11px;
  }
  .btn-preset {
    padding: 7px 9px;
    border-radius: 7px;
    border: 1px solid #35577f;
    background: #143457;
    color: #eaf2ff;
    font-size: 11px;
    font-weight: 650;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
  }
  .btn-preset:hover { background: #1c4777; border-color: #4f7cb5; }
  .btn-preset.active { background: #1a5ea8; border-color: #639fe6; box-shadow: 0 0 10px rgba(42, 134, 239, 0.35); }

  .view-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    margin: 6px 0 10px;
  }
  .btn-view {
    padding: 5px 6px;
    border-radius: 5px;
    border: 1px solid #284465;
    background: #11263e;
    color: #cbe0f8;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: all 0.12s;
  }
  .btn-view:hover { background: #1c3d62; border-color: #426993; color: #fff; }

  .section { border-top: 1px solid #1c324a; padding-top: 10px; margin-top: 10px; }
  h2 { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.7px; color: #7fa4cd; margin: 0 0 7px; }

  .toggle {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 3.5px 0;
    font-size: 11px;
    color: #dbe8fa;
    cursor: pointer;
    user-select: none;
  }
  .toggle:hover { color: #ffffff; }
  .toggle input[type="checkbox"] {
    accent-color: #2a86ef;
    cursor: pointer;
    width: 13px;
    height: 13px;
    margin: 0;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .count-badge {
    margin-left: auto;
    font-size: 9.5px;
    background: #152d47;
    border: 1px solid #213f62;
    padding: 1px 5px;
    border-radius: 4px;
    color: #9abedc;
    font-weight: 600;
  }

  .range-meta {
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
    color: #9cbddf;
    margin-bottom: 4px;
    font-weight: 550;
  }
  input[type="range"] {
    width: 100%;
    accent-color: #2a86ef;
    margin: 0;
    height: 4px;
  }

  /* Right Anatomical Inspector Card */
  #detail {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    width: min(340px, calc(100vw - 32px));
    padding: 14px 16px;
    border: 1px solid #233e5c;
    border-radius: 12px;
    background: #0d1e34ea;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    font-size: 11.5px;
    line-height: 1.45;
  }
  #detail strong { display: block; font-size: 13px; color: #fff; margin-bottom: 3px; }
  #detail .sublabel { color: #8eb3dc; font-size: 10px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; }
  #detail .filename { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 9.5px; color: #7fa4cd; word-break: break-all; background: #13273e; padding: 4px 6px; border-radius: 5px; border: 1px solid #1e3a5a; }

  .footer-note {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 10px;
    color: #607e9e;
    z-index: 5;
    pointer-events: none;
  }
</style>
<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
}
</script>
</head>
<body>

<div class="panel">
  <h1>CardioVision AI · 3D Heart</h1>
  <div class="subtitle">Complete Anatomical BodyParts3D Assembly &amp; Multi-Vessel Coronary Model</div>

  <div id="status"><span class="spinner"></span> Initializing cardiac meshes...</div>

  <div class="preset-row">
    <button class="btn-preset active" id="presetComplete">Complete Heart</button>
    <button class="btn-preset" id="presetCoronary">Coronary Focus</button>
  </div>

  <div class="section" style="border-top:none; padding-top:0; margin-top:0;">
    <h2>Anatomical Camera Views</h2>
    <div class="view-grid">
      <button class="btn-view" data-view="front">Anterior (Front)</button>
      <button class="btn-view" data-view="back">Posterior (Back)</button>
      <button class="btn-view" data-view="left">Left Lateral</button>
      <button class="btn-view" data-view="right">Right Lateral</button>
      <button class="btn-view" data-view="top">Base (Top)</button>
      <button class="btn-view" data-view="bottom">Apex (Bottom)</button>
    </div>
    <button class="btn-view" id="btnReset" style="width:100%; padding:6px;">Reset Camera (Perspective)</button>
  </div>

  <!-- Heart Muscle & Internal Anatomy -->
  <div class="section">
    <h2>Heart Anatomy &amp; Walls</h2>
    <label class="toggle"><input type="checkbox" data-group="ventricles" checked /><span class="dot" style="background:#b85b63"></span> Ventricles &amp; Septa <span class="count-badge">9</span></label>
    <label class="toggle"><input type="checkbox" data-group="atria" checked /><span class="dot" style="background:#cf7d85"></span> Atria &amp; Auricles <span class="count-badge">18</span></label>
    <label class="toggle"><input type="checkbox" data-group="great_vessels" checked /><span class="dot" style="background:#d4a39b"></span> Great Vessels (Aorta &amp; PT) <span class="count-badge">3</span></label>
    <label class="toggle"><input type="checkbox" data-group="valves" checked /><span class="dot" style="background:#eee5d8"></span> Cardiac Valves &amp; Annuli <span class="count-badge">23</span></label>
    <label class="toggle"><input type="checkbox" data-group="internal_myocardium" checked /><span class="dot" style="background:#a84c55"></span> Papillary Muscles &amp; Trabeculae <span class="count-badge">8</span></label>
    <label class="toggle"><input type="checkbox" data-group="cardiac_veins" checked /><span class="dot" style="background:#2e7da9"></span> Cardiac Veins &amp; Sinus <span class="count-badge">9</span></label>
    <label class="toggle"><input type="checkbox" data-group="conduction_system" checked /><span class="dot" style="background:#f6c445"></span> Conduction System (SA/AV/His) <span class="count-badge">11</span></label>
    
    <div style="margin-top:10px;">
      <div class="range-meta"><span>Myocardium Opacity</span><span id="opacityLabel">100%</span></div>
      <input type="range" id="opacity" min="15" max="100" value="100" step="5" />
    </div>
  </div>

  <!-- Coronary Arteries -->
  <div class="section">
    <h2>Coronary Arteries (Target Models)</h2>
    <label class="toggle"><input type="checkbox" data-group="left_coronary_stem" checked /><span class="dot" style="background:#e6d6c2"></span> Left Coronary Stem (LM) <span class="count-badge">1</span></label>
    <label class="toggle"><input type="checkbox" data-group="lad" checked /><span class="dot" style="background:#2a86ef"></span> LAD Trunk (Anterior Descending) <span class="count-badge">3</span></label>
    <label class="toggle"><input type="checkbox" data-group="lad_branches" checked /><span class="dot" style="background:#4da1ff"></span> LAD Branches (Diagonals &amp; Septals) <span class="count-badge">6</span></label>
    <label class="toggle"><input type="checkbox" data-group="lcx" checked /><span class="dot" style="background:#0fb77d"></span> LCX Trunk (Circumflex) <span class="count-badge">2</span></label>
    <label class="toggle"><input type="checkbox" data-group="lcx_branches" checked /><span class="dot" style="background:#38d7a1"></span> LCX Branches (Marginals &amp; Post) <span class="count-badge">3</span></label>
    <label class="toggle"><input type="checkbox" data-group="rca" checked /><span class="dot" style="background:#ff9900"></span> RCA Trunk (Right Coronary) <span class="count-badge">3</span></label>
    <label class="toggle"><input type="checkbox" data-group="rca_branches" checked /><span class="dot" style="background:#ffb74d"></span> RCA Branches (Marginal, SA, AV) <span class="count-badge">7</span></label>
  </div>
</div>

<div id="detail">
  <strong>Anatomical Inspector</strong>
  <span style="color:#8eb3dc;">Click any coronary artery, myocardial wall or internal structure to inspect its anatomical identity and provenance.</span>
</div>

<canvas id="canvas"></canvas>

<div class="footer-note">
  BodyParts3D / Anatomography Postnatal Heart Dataset (BP51782) · Complete Verified Assembly.
</div>

<script type="module">
