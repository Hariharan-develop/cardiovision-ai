import os
import json
import socket
import urllib.parse
import joblib
import pandas as pd
from http.server import HTTPServer, BaseHTTPRequestHandler

# -----------------------------------------------------------------------------
# Load Trained Machine Learning Models & Feature Metadata
# -----------------------------------------------------------------------------
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
cad_model = joblib.load(os.path.join(BASE_DIR, "cad_model.pkl"))
lad_model = joblib.load(os.path.join(BASE_DIR, "lad_model.pkl"))
lcx_model = joblib.load(os.path.join(BASE_DIR, "lcx_model.pkl"))
rca_model = joblib.load(os.path.join(BASE_DIR, "rca_model.pkl"))

# Candidate models (experimental mode) and calibrated thresholds
lcx_model_candidate = joblib.load(os.path.join(BASE_DIR, "lcx_model_candidate.pkl"))
rca_model_candidate = joblib.load(os.path.join(BASE_DIR, "rca_model_candidate.pkl"))

cand_thresh_file = os.path.join(BASE_DIR, "candidate_thresholds.json")
candidate_thresholds = {"LCX": 0.45, "RCA": 0.40}
if os.path.exists(cand_thresh_file):
    try:
        with open(cand_thresh_file, "r", encoding="utf-8") as f:
            candidate_thresholds = json.load(f)
    except Exception:
        pass

CANDIDATE_LCX_THRESH = float(candidate_thresholds.get("LCX", 0.45))
CANDIDATE_RCA_THRESH = float(candidate_thresholds.get("RCA", 0.40))
CANDIDATE_LCX_THRESH_PCT = f"{CANDIDATE_LCX_THRESH * 100.0:.1f}"
CANDIDATE_RCA_THRESH_PCT = f"{CANDIDATE_RCA_THRESH * 100.0:.1f}"

feature_columns = joblib.load(os.path.join(BASE_DIR, "feature_columns.pkl"))
numeric_defaults = joblib.load(os.path.join(BASE_DIR, "numeric_defaults.pkl"))

try:
    from shap_service import get_all_shap_explanations
except ImportError:
    get_all_shap_explanations = None

def compute_predictions(params):
    def get_num(k, default, min_v=None, max_v=None):
        raw = params.get(k)
        if raw is None or raw == "":
            val = float(default)
        else:
            try: val = float(raw)
            except (ValueError, TypeError): val = float(default)
        if min_v is not None: val = max(float(min_v), val)
        if max_v is not None: val = min(float(max_v), val)
        return val

    def get_int(k, default, min_v=None, max_v=None):
        raw = params.get(k)
        if raw is None or raw == "":
            val = int(default)
        else:
            try: val = int(float(raw))
            except (ValueError, TypeError): val = int(default)
        if min_v is not None: val = max(int(min_v), val)
        if max_v is not None: val = min(int(max_v), val)
        return val

    def get_str(k, default, allowed=None):
        raw = params.get(k)
        if raw is None or raw == "":
            val = str(default)
        else:
            val = str(raw)
        if allowed and val not in allowed:
            val = str(default)
        return val

    # Basic Information
    age = get_num("age", 58.0, 1.0, 120.0)
    length = get_num("length", 170.0, 50.0, 250.0)
    weight = get_num("weight", 72.0, 20.0, 300.0)
    calc_bmi = round(weight / ((length / 100.0) ** 2), 1)
    sex = get_str("sex", "Male", ["Male", "Female"])

    # Medical History
    dm = get_int("dm", 0, 0, 1)
    htn = get_int("htn", 1, 0, 1)
    current_smoker = get_int("current_smoker", 0, 0, 1)
    ex_smoker = get_int("ex_smoker", 0, 0, 1)
    fh = get_int("fh", 0, 0, 1)
    obesity = get_str("obesity", "N", ["N", "Y"])
    crf = get_str("crf", "N", ["N", "Y"])
    cva = get_str("cva", "N", ["N", "Y"])

    # Symptoms
    chest_pain_opt = get_str("chest_pain", "Y", ["Y", "N"])
    chest_pain = 1.0 if chest_pain_opt == "Y" else 0.0
    dyspnea = get_str("dyspnea", "N", ["N", "Y"])
    atypical = get_str("atypical", "N", ["N", "Y"])
    nonanginal = get_str("nonanginal", "N", ["N", "Y"])
    lowth_ang = get_str("lowth_ang", "N", ["N", "Y"])
    poor_r = get_str("poor_r", "N", ["N", "Y"])

    # Vital Signs
    bp = get_num("bp", numeric_defaults["BP"], 50.0, 260.0)
    pr = get_num("pr", numeric_defaults["PR"], 30.0, 220.0)
    ef_tte = get_num("ef_tte", numeric_defaults["EF-TTE"], 10.0, 85.0)

    # Laboratory Biomarkers
    fbs = get_num("fbs", numeric_defaults["FBS"], 40.0, 600.0)
    cr = get_num("cr", numeric_defaults["CR"], 0.1, 15.0)
    tg = get_num("tg", numeric_defaults["TG"], 20.0, 1000.0)
    ldl = get_num("ldl", numeric_defaults["LDL"], 10.0, 500.0)
    hdl = get_num("hdl", numeric_defaults["HDL"], 5.0, 150.0)
    bun = get_num("bun", numeric_defaults["BUN"], 1.0, 150.0)
    esr = get_num("esr", numeric_defaults["ESR"], 0.0, 150.0)
    hb = get_num("hb", numeric_defaults["HB"], 3.0, 25.0)
    k = get_num("k", numeric_defaults["K"], 1.5, 9.0)
    na = get_num("na", numeric_defaults["Na"], 100.0, 180.0)
    wbc = get_num("wbc", numeric_defaults["WBC"], 1000.0, 50000.0)
    lymph = get_num("lymph", numeric_defaults["Lymph"], 1.0, 99.0)
    neut = get_num("neut", numeric_defaults["Neut"], 1.0, 99.0)
    plt = get_num("plt", numeric_defaults["PLT"], 10.0, 1000.0)

    # ECG & Cardiac Telemetry
    q_wave = get_int("q_wave", int(numeric_defaults["Q Wave"]), 0, 1)
    st_elevation = get_int("st_elevation", int(numeric_defaults["St Elevation"]), 0, 1)
    st_depression = get_int("st_depression", int(numeric_defaults["St Depression"]), 0, 1)
    tinversion = get_int("tinversion", int(numeric_defaults["Tinversion"]), 0, 1)
    lvh = get_str("lvh", "N", ["N", "Y"])
    bbb = get_str("bbb", "N", ["N", "LBBB", "RBBB"])
    region_rwma = get_num("region_rwma", numeric_defaults["Region RWMA"], 0.0, 4.0)
    vhd = get_str("vhd", "N", ["N", "mild", "Moderate", "Severe"])

    # Additional Findings
    edema = get_int("edema", int(numeric_defaults["Edema"]), 0, 1)
    function_class = get_int("function_class", int(numeric_defaults["Function Class"]), 0, 4)
    airway = get_str("airway", "N", ["N", "Y"])
    thyroid = get_str("thyroid", "N", ["N", "Y"])
    chf = get_str("chf", "N", ["N", "Y"])
    dlp = get_str("dlp", "N", ["N", "Y"])
    weak_pulse = get_str("weak_pulse", "N", ["N", "Y"])
    lung_rales = get_str("lung_rales", "N", ["N", "Y"])
    systolic_murmur = get_str("systolic_murmur", "N", ["N", "Y"])
    diastolic_murmur = get_str("diastolic_murmur", "N", ["N", "Y"])

    # Build 57-feature vector
    patient = pd.DataFrame([[0.0] * len(feature_columns)], columns=feature_columns)
    numeric_values = {
        "Age": age, "Weight": weight, "Length": length, "BMI": calc_bmi,
        "DM": dm, "HTN": htn, "Current Smoker": current_smoker, "EX-Smoker": ex_smoker, "FH": fh,
        "BP": bp, "PR": pr, "Edema": edema, "Typical Chest Pain": chest_pain, "Function Class": function_class,
        "Q Wave": q_wave, "St Elevation": st_elevation, "St Depression": st_depression, "Tinversion": tinversion,
        "FBS": fbs, "CR": cr, "TG": tg, "LDL": ldl, "HDL": hdl, "BUN": bun, "ESR": esr, "HB": hb, "K": k, "Na": na,
        "WBC": wbc, "Lymph": lymph, "Neut": neut, "PLT": plt, "EF-TTE": ef_tte, "Region RWMA": region_rwma,
    }
    for col, value in numeric_values.items():
        patient.loc[0, col] = float(value)

    patient.loc[0, "Sex_Male"] = 1.0 if sex == "Male" else 0.0
    patient.loc[0, "Obesity_Y"] = 1.0 if obesity == "Y" else 0.0
    patient.loc[0, "CRF_Y"] = 1.0 if crf == "Y" else 0.0
    patient.loc[0, "CVA_Y"] = 1.0 if cva == "Y" else 0.0
    patient.loc[0, "Airway disease_Y"] = 1.0 if airway == "Y" else 0.0
    patient.loc[0, "Thyroid Disease_Y"] = 1.0 if thyroid == "Y" else 0.0
    patient.loc[0, "CHF_Y"] = 1.0 if chf == "Y" else 0.0
    patient.loc[0, "DLP_Y"] = 1.0 if dlp == "Y" else 0.0
    patient.loc[0, "Weak Peripheral Pulse_Y"] = 1.0 if weak_pulse == "Y" else 0.0
    patient.loc[0, "Lung rales_Y"] = 1.0 if lung_rales == "Y" else 0.0
    patient.loc[0, "Systolic Murmur_Y"] = 1.0 if systolic_murmur == "Y" else 0.0
    patient.loc[0, "Diastolic Murmur_Y"] = 1.0 if diastolic_murmur == "Y" else 0.0
    patient.loc[0, "Dyspnea_Y"] = 1.0 if dyspnea == "Y" else 0.0
    patient.loc[0, "Atypical_Y"] = 1.0 if atypical == "Y" else 0.0
    patient.loc[0, "Nonanginal_Y"] = 1.0 if nonanginal == "Y" else 0.0
    patient.loc[0, "LowTH Ang_Y"] = 1.0 if lowth_ang == "Y" else 0.0
    patient.loc[0, "LVH_Y"] = 1.0 if lvh == "Y" else 0.0
    patient.loc[0, "Poor R Progression_Y"] = 1.0 if poor_r == "Y" else 0.0
    patient.loc[0, "BBB_N"] = 1.0 if bbb == "N" else 0.0
    patient.loc[0, "BBB_RBBB"] = 1.0 if bbb == "RBBB" else 0.0
    patient.loc[0, "VHD_N"] = 1.0 if vhd == "N" else 0.0
    patient.loc[0, "VHD_mild"] = 1.0 if vhd == "mild" else 0.0
    patient.loc[0, "VHD_Severe"] = 1.0 if vhd == "Severe" else 0.0

    X = patient[feature_columns].astype(float)

    mode = str(params.get("model_mode", "standard")).lower()
    is_candidate = mode in ["candidate", "experimental"] or str(params.get("experimental", "0")).lower() in ["1", "true", "yes"]

    def class_prob(model, target_label):
        classes = list(model.classes_)
        idx = classes.index(target_label)
        return float(model.predict_proba(X)[0][idx] * 100.0)

    def get_tier(prob):
        if prob < 50.0: return "tierLow", "Low Est. Prob (<50%)"
        elif prob < 70.0: return "tierModerate", "Moderate Est. Prob (50–69%)"
        else: return "tierHigh", "High Est. Prob (≥70%)"

    cad_r = class_prob(cad_model, "CAD")
    cad_lbl = str(cad_model.predict(X)[0])
    lad_r = class_prob(lad_model, "Stenotic")
    lad_lbl = str(lad_model.predict(X)[0])

    if is_candidate:
        # Candidate models use numeric classes: 0 = Normal, 1 = Stenotic.
        # Retrieve the probability for class 1 using model.classes_, not a hardcoded index.
        classes_lcx = list(lcx_model_candidate.classes_)
        idx_lcx = classes_lcx.index(1)
        lcx_prob_ratio = float(lcx_model_candidate.predict_proba(X)[0][idx_lcx])
        lcx_r = float(lcx_prob_ratio * 100.0)

        classes_rca = list(rca_model_candidate.classes_)
        idx_rca = classes_rca.index(1)
        rca_prob_ratio = float(rca_model_candidate.predict_proba(X)[0][idx_rca])
        rca_r = float(rca_prob_ratio * 100.0)

        lcx_thresh = float(candidate_thresholds.get("LCX", 0.45))
        rca_thresh = float(candidate_thresholds.get("RCA", 0.40))

        # Apply candidate thresholds only to Normal/Stenotic classification
        lcx_lbl = "Stenotic" if lcx_prob_ratio >= lcx_thresh else "Normal"
        rca_lbl = "Stenotic" if rca_prob_ratio >= rca_thresh else "Normal"

        lcx_model_file = "lcx_model_candidate.pkl"
        rca_model_file = "rca_model_candidate.pkl"
    else:
        lcx_r = class_prob(lcx_model, "Stenotic")
        lcx_lbl = str(lcx_model.predict(X)[0])
        rca_r = class_prob(rca_model, "Stenotic")
        rca_lbl = str(rca_model.predict(X)[0])
        lcx_thresh = 0.5
        rca_thresh = 0.5
        lcx_model_file = "lcx_model.pkl"
        rca_model_file = "rca_model.pkl"

    cad_tc, cad_tl = get_tier(cad_r)
    lad_tc, lad_tl = get_tier(lad_r)
    lcx_tc, lcx_tl = get_tier(lcx_r)
    rca_tc, rca_tl = get_tier(rca_r)

    # Format features for patient view
    features_dict = {col: round(float(X.loc[0, col]), 2) for col in feature_columns}

    # Compute patient-specific SHAP explanations
    active_lcx_model = lcx_model_candidate if is_candidate else lcx_model
    active_rca_model = rca_model_candidate if is_candidate else rca_model
    shap_explanations = {}
    if get_all_shap_explanations is not None:
        try:
            shap_explanations = get_all_shap_explanations(
                cad_model, lad_model, active_lcx_model, active_rca_model, X, is_candidate=is_candidate
            )
        except Exception as e:
            shap_explanations = {"available": False, "error": str(e)}

    return {
        "success": True,
        "model_mode": "candidate" if is_candidate else "standard",
        "is_candidate_mode": is_candidate,
        "lcx_threshold": lcx_thresh,
        "rca_threshold": rca_thresh,
        "lcx_thresh_pct": f"{lcx_thresh * 100.0:.1f}",
        "rca_thresh_pct": f"{rca_thresh * 100.0:.1f}",
        "candidate_lcx_threshold": CANDIDATE_LCX_THRESH,
        "candidate_rca_threshold": CANDIDATE_RCA_THRESH,
        "candidate_lcx_thresh_pct": CANDIDATE_LCX_THRESH_PCT,
        "candidate_rca_thresh_pct": CANDIDATE_RCA_THRESH_PCT,
        "lcx_model_file": lcx_model_file,
        "rca_model_file": rca_model_file,
        "cad_risk": round(cad_r, 1), "cad_pct": int(round(cad_r)), "cad_label": cad_lbl,
        "cad_tier_class": cad_tc, "cad_tier_label": cad_tl,
        "lad_risk": round(lad_r, 1), "lad_pct": int(round(lad_r)), "lad_label": lad_lbl,
        "lad_tier_class": lad_tc, "lad_tier_label": lad_tl,
        "lcx_risk": round(lcx_r, 1), "lcx_pct": int(round(lcx_r)), "lcx_label": lcx_lbl,
        "lcx_tier_class": lcx_tc, "lcx_tier_label": lcx_tl,
        "rca_risk": round(rca_r, 1), "rca_pct": int(round(rca_r)), "rca_label": rca_lbl,
        "rca_tier_class": rca_tc, "rca_tier_label": rca_tl,
        "bmi": calc_bmi,
        "age": age, "length": length, "weight": weight, "sex": sex,
        "bp": bp, "pr": pr,
        "features": features_dict,
        "shap_explanations": shap_explanations
    }

class PredictionAPIHandler(BaseHTTPRequestHandler):
    def _set_cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def do_OPTIONS(self):
        self.send_response(200)
        self._set_cors()
        self.end_headers()

    def _serve_file(self, file_path, content_type="text/plain; charset=utf-8"):
        if os.path.exists(file_path) and os.path.isfile(file_path):
            try:
                with open(file_path, "rb") as f:
                    data = f.read()
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(data)))
                self._set_cors()
                self.end_headers()
                self.wfile.write(data)
                return True
            except Exception:
                pass
        self.send_response(404)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self._set_cors()
        self.end_headers()
        self.wfile.write(b"File not found")
        return False

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        clean_path = self.path.split("?")[0]
        if clean_path.startswith("/models/"):
            rel_name = urllib.parse.unquote(clean_path[len("/models/"):])
            models_dir = os.path.join(BASE_DIR, "assets", "bodyparts3d")
            file_path = os.path.normpath(os.path.join(models_dir, rel_name))
            if file_path.startswith(models_dir):
                self._serve_file(file_path, "text/plain; charset=utf-8")
                return
            else:
                self.send_response(403)
                self.end_headers()
                return
        elif clean_path == "/viewer.html" or clean_path == "/3d-viewer":
            v_path = os.path.join(BASE_DIR, "components", "heart_viewer.html")
            if not os.path.exists(v_path):
                v_path = os.path.join(BASE_DIR, "3d-test", "viewer.html")
            self._serve_file(v_path, "text/html; charset=utf-8")
            return
        elif clean_path == "/mesh_manifest.csv":
            m_path = os.path.join(BASE_DIR, "3d-test", "mesh_manifest.csv")
            self._serve_file(m_path, "text/csv; charset=utf-8")
            return
        elif clean_path.startswith("/api/health"):
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self._set_cors()
            self.end_headers()
            res = json.dumps({"status": "ok", "service": "CardioVision Prediction API"})
            self.wfile.write(res.encode("utf-8"))
            return
        elif clean_path.startswith("/api/defaults"):
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self._set_cors()
            self.end_headers()
            res = json.dumps(compute_predictions({}), ensure_ascii=False)
            self.wfile.write(res.encode("utf-8"))
            return
        elif clean_path == "/api/predict":
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self._set_cors()
            self.end_headers()
            res = json.dumps(compute_predictions({}), ensure_ascii=False)
            self.wfile.write(res.encode("utf-8"))
            return
        elif clean_path in ["/api/generate-pdf", "/api/export-pdf"]:
            try:
                from pdf_generator import generate_pdf_report
                preds = compute_predictions({})
                pdf_bytes = generate_pdf_report(
                    patient_data={"id": "CV-2026-8492", "displayName": "Alex Morgan (Demo Patient)", "age": 58, "sex": "Male"},
                    predictions=preds,
                    shap_explanations=preds.get("shap_explanations", {}),
                    model_mode=preds.get("model_mode", "standard"),
                )
                self.send_response(200)
                self.send_header("Content-Type", "application/pdf")
                self.send_header("Content-Disposition", 'attachment; filename="CardioVision_Research_Report.pdf"')
                self.send_header("Content-Length", str(len(pdf_bytes)))
                self._set_cors()
                self.end_headers()
                self.wfile.write(pdf_bytes)
                return
            except Exception as e:
                self.send_response(500)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self._set_cors()
                self.end_headers()
                res = json.dumps({"success": False, "error": str(e)})
                self.wfile.write(res.encode("utf-8"))
                return
        else:
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self._set_cors()
            self.end_headers()
            res = json.dumps({"status": "ready"})
            self.wfile.write(res.encode("utf-8"))

    def do_POST(self):
        clean_path = self.path.split("?")[0]
        content_len = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
        try:
            params = json.loads(body)
        except Exception:
            params = {}

        if clean_path in ["/api/generate-pdf", "/api/export-pdf"]:
            try:
                from pdf_generator import generate_pdf_report
                # Extract patient inputs and predictions
                patient_data = params.get("patient_data") or params
                model_mode = params.get("model_mode") or patient_data.get("model_mode") or "standard"
                
                # Compute predictions & SHAP if not provided
                predictions = params.get("predictions")
                if not predictions:
                    computed = compute_predictions(params)
                    predictions = computed
                    shap_data = computed.get("shap_explanations", {})
                else:
                    shap_data = params.get("shap_explanations") or predictions.get("shap_explanations", {})

                snapshot_url = params.get("snapshot_data_url") or params.get("snapshot_url")
                
                pdf_bytes = generate_pdf_report(
                    patient_data=patient_data,
                    predictions=predictions,
                    shap_explanations=shap_data,
                    model_mode=model_mode,
                    snapshot_data_url=snapshot_url
                )

                pat_id = patient_data.get("id") or patient_data.get("patient_id") or "CV-2026-8492"
                import re
                safe_id = re.sub(r'[^a-zA-Z0-9_\-]', '_', str(pat_id))
                filename = f"CardioVision_Research_Report_{safe_id}.pdf"

                self.send_response(200)
                self.send_header("Content-Type", "application/pdf")
                self.send_header("Content-Disposition", f'attachment; filename="{filename}"')
                self.send_header("Content-Length", str(len(pdf_bytes)))
                self._set_cors()
                self.end_headers()
                self.wfile.write(pdf_bytes)
                return
            except Exception as e:
                self.send_response(500)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self._set_cors()
                self.end_headers()
                res = json.dumps({"success": False, "error": str(e)})
                self.wfile.write(res.encode("utf-8"))
                return

        result = compute_predictions(params)
        res = json.dumps(result, ensure_ascii=False)
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self._set_cors()
        self.end_headers()
        self.wfile.write(res.encode("utf-8"))

    def log_message(self, format, *args):
        # Silent logging
        pass

def run_server(port=8502):
    server = HTTPServer(("127.0.0.1", port), PredictionAPIHandler)
    server.serve_forever()

if __name__ == "__main__":
    run_server(8502)
