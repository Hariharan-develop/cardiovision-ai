# CardioVision AI - Environment Configuration Example
# Copy this file to .env for local customized configuration.

# Application Server Port (default: 8502)
PORT=8502
HOST=127.0.0.1

# Public Render API Server URL (used in production to connect Streamlit dashboard to 3D Viewer & API)
# CARDIOVISION_API_URL=https://cardiovision-ai-l3vg.onrender.com

# OCR Configuration (Optional - for scanned PDF extraction)
# Set to the path of your local Tesseract OCR executable if not on system PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database Path (default: data/prediction_history.db)
DB_PATH=data/prediction_history.db

# Logging Level
LOG_LEVEL=INFO
