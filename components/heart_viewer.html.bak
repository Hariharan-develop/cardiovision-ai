<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CardioVision AI 3D Coronary Viewer</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #080d1a;
      color: #e2e8f0;
    }
    #viewer-container {
      position: relative;
      width: 100%;
      height: 100vh;
      background: radial-gradient(circle at 50% 30%, #152238 0%, #090e1c 65%, #050811 100%);
      overflow: hidden;
    }
    canvas#webgl-canvas {
      width: 100%;
      height: 100%;
      display: block;
      outline: none;
    }

    /* Top HUD Header */
    .hud-header {
      position: absolute;
      top: 14px;
      left: 18px;
      right: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      z-index: 10;
    }
    .hud-title-box {
      background: rgba(12, 20, 36, 0.82);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(56, 189, 248, 0.22);
      border-radius: 12px;
      padding: 8px 16px;
      pointer-events: auto;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }
    .hud-title {
      font-size: 14px;
      font-weight: 800;
      color: #f8fafc;
      letter-spacing: 0.3px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hud-title .heart-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
      box-shadow: 0 0 10px #ef4444;
      animation: pulse-dot 1.4s infinite ease-in-out;
    }
    @keyframes pulse-dot {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.6; }
    }
    .hud-subtitle {
      font-size: 11px;
      color: #94a3b8;
      margin-top: 2px;
    }

    /* Camera Presets Toolbar */
    .hud-toolbar {
      display: flex;
      gap: 6px;
      background: rgba(12, 20, 36, 0.82);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 5px;
      pointer-events: auto;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }
    .hud-btn {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #cbd5e1;
      font-size: 11px;
      font-weight: 600;
      padding: 6px 11px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .hud-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      color: #38bdf8;
      border-color: rgba(56, 189, 248, 0.4);
    }
    .hud-btn.active {
      background: #0284c7;
      color: #fff;
      border-color: #38bdf8;
    }

    /* Left Inspection Telemetry HUD */
    .hud-telemetry {
      position: absolute;
      top: 76px;
      left: 18px;
      width: 280px;
      background: rgba(10, 17, 32, 0.86);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 14px;
      padding: 14px;
      z-index: 10;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
      transition: border-color 0.25s ease;
    }
    .telem-tag {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #38bdf8;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .telem-vessel-name {
      font-size: 16px;
      font-weight: 800;
      color: #f1f5f9;
      line-height: 1.25;
      margin-bottom: 8px;
    }
    .telem-metrics-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 10px 0;
      padding: 8px 10px;
      background: rgba(15, 23, 42, 0.7);
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .telem-prob {
      font-size: 26px;
      font-weight: 900;
      color: #f8fafc;
      line-height: 1;
    }
    .telem-prob span {
      font-size: 12px;
      color: #94a3b8;
      font-weight: 600;
    }
    .telem-status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .badge-high {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.5);
    }
    .badge-moderate {
      background: rgba(245, 158, 11, 0.2);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.5);
    }
    .badge-low {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.5);
    }
    .telem-desc {
      font-size: 11px;
      color: #94a3b8;
      line-height: 1.45;
      margin-top: 6px;
    }
    .telem-territory {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      font-size: 11px;
      color: #cbd5e1;
    }
    .telem-territory b {
      color: #38bdf8;
    }

    /* Bottom Control Bar & Legend */
    .hud-bottom {
      position: absolute;
      bottom: 14px;
      left: 18px;
      right: 18px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      pointer-events: none;
      z-index: 10;
    }
    .vessel-selector-group {
      display: flex;
      gap: 8px;
      pointer-events: auto;
    }
    .vessel-pill-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(12, 20, 36, 0.86);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      padding: 8px 14px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    }
    .vessel-pill-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(56, 189, 248, 0.5);
    }
    .vessel-pill-btn.active {
      border-color: #38bdf8;
      box-shadow: 0 0 16px rgba(56, 189, 248, 0.35);
      background: rgba(20, 33, 58, 0.95);
    }
    .vessel-color-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .vessel-pill-name {
      font-size: 12px;
      font-weight: 750;
      color: #f1f5f9;
    }
    .vessel-pill-risk {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.08);
      color: #cbd5e1;
    }

    /* Risk Color Scale Legend */
    .hud-legend-box {
      background: rgba(12, 20, 36, 0.86);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 8px 14px;
      pointer-events: auto;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .legend-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #94a3b8;
    }
    .legend-items {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: #cbd5e1;
      font-weight: 600;
    }
    .legend-swatch {
      width: 10px;
      height: 10px;
      border-radius: 3px;
    }

    /* Architecture Badge */
    .arch-badge {
      position: absolute;
      bottom: 60px;
      right: 18px;
      background: rgba(8, 14, 26, 0.82);
      border: 1px dashed rgba(56, 189, 248, 0.3);
      border-radius: 10px;
      padding: 5px 10px;
      font-size: 10px;
      color: #38bdf8;
      pointer-events: none;
      z-index: 10;
    }

    /* Click indicator tooltip */
    .hint-tooltip {
      position: absolute;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 4px 14px;
      font-size: 11px;
      color: #94a3b8;
      pointer-events: none;
      z-index: 9;
    }
    .hint-tooltip b {
      color: #f1f5f9;
    }

    @media (max-width: 900px) {
      .hud-telemetry { width: 230px; font-size: 10px; }
      .vessel-selector-group { flex-direction: column; gap: 4px; }
      .hint-tooltip { display: none; }
    }
  </style>

  <!-- Three.js + OrbitControls + GLTFLoader -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
</head>
<body>
  <div id="viewer-container">
    <canvas id="webgl-canvas"></canvas>

    <!-- Top Header -->
    <div class="hud-header">
      <div class="hud-title-box">
        <div class="hud-title">
          <div class="heart-dot"></div>
          CardioVision 3D Coronary Explorer
        </div>
        <div class="hud-subtitle">Interactive Biomechanical Coronary Tree &bull; Vessel Stenosis Mapping</div>
      </div>

      <div class="hud-toolbar">
        <button class="hud-btn active" id="btn-view-ant" onclick="setCameraView('anterior')">Anterior</button>
        <button class="hud-btn" id="btn-view-lao" onclick="setCameraView('lao')">LAO</button>
        <button class="hud-btn" id="btn-view-rao" onclick="setCameraView('rao')">RAO</button>
        <button class="hud-btn" id="btn-view-post" onclick="setCameraView('posterior')">Posterior</button>
        <button class="hud-btn" id="btn-pulse" onclick="togglePulse()">&#9829; Pulse</button>
        <button class="hud-btn" onclick="resetCamera()">Reset</button>
      </div>
    </div>

    <!-- Click hint -->
    <div class="hint-tooltip">
      Drag to rotate &bull; Scroll to zoom &bull; <b>Click vessels</b> or buttons to inspect
    </div>

    <!-- Left Telemetry Panel -->
    <div class="hud-telemetry" id="telemetry-panel">
      <div class="telem-tag" id="telem-tag">CORONARY VESSEL TELEMETRY</div>
      <div class="telem-vessel-name" id="telem-name">Select Vessel</div>
      <div class="telem-metrics-row">
        <div>
          <div style="font-size: 10px; color: #94a3b8; font-weight: 600;">STENOSIS RISK</div>
          <div class="telem-prob" id="telem-prob">--<span>%</span></div>
        </div>
        <div id="telem-badge" class="telem-status-badge badge-low">Normal</div>
      </div>
      <div class="telem-desc" id="telem-desc">
        Click on any coronary artery (LAD, LCX, RCA) or the bottom selector buttons to view stenosis risk probability, perfused myocardial territory, and clinical interpretation.
      </div>
      <div class="telem-territory" id="telem-territory">
        <b>Myocardial Territory:</b> Awaiting vessel selection
      </div>
    </div>

    <!-- Architecture Extensibility Badge -->
    <div class="arch-badge">
      &#10003; 3D Engine Architecture Ready for Anatomical .glb/.gltf Heart Asset
    </div>

    <!-- Bottom Controls & Legend -->
    <div class="hud-bottom">
      <div class="vessel-selector-group">
        <div class="vessel-pill-btn" id="btn-vessel-lad" onclick="selectVessel('LAD')">
          <div class="vessel-color-dot" id="dot-lad" style="background:#ef4444;"></div>
          <div class="vessel-pill-name">LAD</div>
          <div class="vessel-pill-risk" id="pill-lad">82.0%</div>
        </div>
        <div class="vessel-pill-btn" id="btn-vessel-lcx" onclick="selectVessel('LCX')">
          <div class="vessel-color-dot" id="dot-lcx" style="background:#f59e0b;"></div>
          <div class="vessel-pill-name">LCX</div>
          <div class="vessel-pill-risk" id="pill-lcx">55.0%</div>
        </div>
        <div class="vessel-pill-btn" id="btn-vessel-rca" onclick="selectVessel('RCA')">
          <div class="vessel-color-dot" id="dot-rca" style="background:#f59e0b;"></div>
          <div class="vessel-pill-name">RCA</div>
          <div class="vessel-pill-risk" id="pill-rca">53.9%</div>
        </div>
      </div>

      <div class="hud-legend-box">
        <div class="legend-title">Stenosis Risk Severity Mapping</div>
        <div class="legend-items">
          <div class="legend-item">
            <div class="legend-swatch" style="background:#10b981;"></div>
            <span>Low (&lt;50%)</span>
          </div>
          <div class="legend-item">
            <div class="legend-swatch" style="background:#f59e0b;"></div>
            <span>Moderate (50-70%)</span>
          </div>
          <div class="legend-item">
            <div class="legend-swatch" style="background:#ef4444;"></div>
            <span>High (&ge;70%)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // INJECTED PREDICTION VALUES FROM PYTHON
    // =========================================================================
    window.CARDIO_DATA = {
      CAD: { risk: {{CAD_RISK}}, label: "{{CAD_LABEL}}" },
      LAD: { risk: {{LAD_RISK}}, label: "{{LAD_LABEL}}" },
      LCX: { risk: {{LCX_RISK}}, label: "{{LCX_LABEL}}" },
      RCA: { risk: {{RCA_RISK}}, label: "{{RCA_LABEL}}" }
    };

    // Clinical Metadata for Coronary Vessels
    const VESSEL_METADATA = {
      LAD: {
        shortName: "LAD",
        fullName: "Left Anterior Descending Artery (LAD)",
        territory: "Anterior left ventricular wall, anterior 2/3 of interventricular septum, and apex.",
        desc: "Clinically the most critical coronary artery. Severe stenosis compromises extensive left ventricular myocardial mass and cardiac output.",
        cameraAngle: { x: 0.8, y: 1.0, z: 6.8 }
      },
      LCX: {
        shortName: "LCX",
        fullName: "Left Circumflex Artery (LCX)",
        territory: "Lateral and posterolateral walls of the left ventricle, anterolateral papillary muscle.",
        desc: "Courses along the left atrioventricular groove. Stenosis often leads to lateral wall ischemia and mitral valve dysfunction.",
        cameraAngle: { x: 5.5, y: 1.2, z: 4.8 }
      },
      RCA: {
        shortName: "RCA",
        fullName: "Right Coronary Artery (RCA)",
        territory: "Right ventricle, inferior/posterior left ventricular wall, and AV conduction node.",
        desc: "Originates from right coronary sinus. Severe stenosis is associated with inferior wall myocardial infarction and cardiac arrhythmias.",
        cameraAngle: { x: -5.2, y: 1.0, z: 4.6 }
      }
    };

    // Color logic
    function getRiskColorHex(risk) {
      if (risk >= 70) return 0xef4444; // Red
      if (risk >= 50) return 0xf59e0b; // Amber
      return 0x10b981; // Green
    }
    function getRiskColorCss(risk) {
      if (risk >= 70) return "#ef4444";
      if (risk >= 50) return "#f59e0b";
      return "#10b981";
    }
    function getRiskBadgeClass(risk) {
      if (risk >= 70) return "badge-high";
      if (risk >= 50) return "badge-moderate";
      return "badge-low";
    }
    function getRiskTierText(risk, label) {
      if (risk >= 70) return label === "Stenotic" ? "High Risk (Stenotic)" : "High Risk (" + risk.toFixed(1) + "%)";
      if (risk >= 50) return label === "Stenotic" ? "Moderate Risk (Stenotic)" : "Moderate Risk (" + risk.toFixed(1) + "%)";
      return "Low Risk (Normal)";
    }

    // =========================================================================
    // THREE.JS SCENE SETUP
    // =========================================================================
    const container = document.getElementById('viewer-container');
    const canvas = document.getElementById('webgl-canvas');

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x090e1c, 0.04);

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0.8, 7.5);

    const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.25;

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.minDistance = 3.2;
    controls.maxDistance = 14.0;
    controls.target.set(0, 0.2, 0);

    // =========================================================================
    // LIGHTING SETUP
    // =========================================================================
    const ambientLight = new THREE.AmbientLight(0x384a6b, 1.2);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 1.3);
    dirLight1.position.set(6, 10, 8);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x38bdf8, 0.9);
    dirLight2.position.set(-8, -4, -6);
    scene.add(dirLight2);

    const rimLight = new THREE.DirectionalLight(0xf43f5e, 0.6);
    rimLight.position.set(0, 5, -8);
    scene.add(rimLight);

    // =========================================================================
    // ANATOMICAL HEART & CORONARY ARTERY GEOMETRIES
    // =========================================================================
    const heartRoot = new THREE.Group();
    scene.add(heartRoot);

    // 1. Myocardium Base Body (Organic Cardiac Silhouette)
    const myocardiumGroup = new THREE.Group();
    heartRoot.add(myocardiumGroup);

    const myocardiumMat = new THREE.MeshStandardMaterial({
      color: 0x881326,
      roughness: 0.45,
      metalness: 0.12,
      transparent: true,
      opacity: 0.76,
      depthWrite: true,
      side: THREE.DoubleSide
    });

    // Ventricular body
    const ventGeom = new THREE.SphereGeometry(1.5, 48, 48);
    // Deform into anatomical cardiac shape (cone tapering to apex pointing antero-inferiorly)
    const pos = ventGeom.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      let x = pos.getX(i);
      let y = pos.getY(i);
      let z = pos.getZ(i);

      // Taper bottom to apex
      if (y < 0) {
        let factor = 1 + y * 0.45;
        x *= factor;
        z *= factor;
        x += y * 0.18; // Apex tilt to left
        z += y * 0.12; // Apex tilt anteriorly
      } else {
        // Expand base
        x *= 1.05;
        z *= 0.95;
      }
      pos.setXYZ(i, x, y, z);
    }
    ventGeom.computeVertexNormals();
    const ventMesh = new THREE.Mesh(ventGeom, myocardiumMat);
    ventMesh.position.set(0, -0.2, 0);
    myocardiumGroup.add(ventMesh);

    // Left Atrium bulge
    const laGeom = new THREE.SphereGeometry(0.72, 32, 32);
    const laMesh = new THREE.Mesh(laGeom, myocardiumMat);
    laMesh.position.set(0.65, 1.0, -0.4);
    laMesh.scale.set(1.0, 0.9, 0.85);
    myocardiumGroup.add(laMesh);

    // Right Atrium bulge
    const raGeom = new THREE.SphereGeometry(0.8, 32, 32);
    const raMesh = new THREE.Mesh(raGeom, myocardiumMat);
    raMesh.position.set(-0.85, 0.9, 0.1);
    raMesh.scale.set(0.9, 1.1, 0.85);
    myocardiumGroup.add(raMesh);

    // 2. Great Vessels: Aorta & Pulmonary Trunk
    const aortaMat = new THREE.MeshStandardMaterial({
      color: 0xa82030,
      roughness: 0.35,
      metalness: 0.18
    });

    // Aorta Arch Curve
    const aortaCurve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0.05, 0.6, 0.1),
      new THREE.Vector3(0.0, 1.4, 0.1),
      new THREE.Vector3(-0.15, 2.0, -0.1),
      new THREE.Vector3(0.35, 2.2, -0.45),
      new THREE.Vector3(0.65, 1.7, -0.85),
      new THREE.Vector3(0.7, 0.4, -0.95)
    ]);
    const aortaGeom = new THREE.TubeGeometry(aortaCurve, 40, 0.34, 24, false);
    const aortaMesh = new THREE.Mesh(aortaGeom, aortaMat);
    heartRoot.add(aortaMesh);

    // Supra-aortic Branches (Brachiocephalic, Carotid, Subclavian)
    const branchMat = aortaMat;
    const branch1 = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.45, 16), branchMat);
    branch1.position.set(0.0, 2.25, -0.2);
    branch1.rotation.z = -0.15;
    heartRoot.add(branch1);

    const branch2 = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.42, 16), branchMat);
    branch2.position.set(0.25, 2.32, -0.38);
    branch2.rotation.z = 0.05;
    heartRoot.add(branch2);

    const branch3 = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.4, 16), branchMat);
    branch3.position.set(0.5, 2.2, -0.55);
    branch3.rotation.z = 0.25;
    heartRoot.add(branch3);

    // Pulmonary Trunk (Anatomical Royal Blue)
    const pulmoMat = new THREE.MeshStandardMaterial({
      color: 0x1d4ed8,
      roughness: 0.4,
      metalness: 0.15
    });
    const pulmoCurve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(0.3, 0.5, 0.6),
      new THREE.Vector3(0.15, 1.2, 0.45),
      new THREE.Vector3(-0.25, 1.6, 0.05)
    ]);
    const pulmoGeom = new THREE.TubeGeometry(pulmoCurve, 24, 0.32, 20, false);
    const pulmoMesh = new THREE.Mesh(pulmoGeom, pulmoMat);
    heartRoot.add(pulmoMesh);

    // Pulmonary Left & Right Branches
    const pulmoBranchCurveL = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-0.25, 1.6, 0.05),
      new THREE.Vector3(0.65, 1.5, -0.6)
    ]);
    const pulmoBranchCurveR = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-0.25, 1.6, 0.05),
      new THREE.Vector3(-1.1, 1.45, -0.4)
    ]);
    heartRoot.add(new THREE.Mesh(new THREE.TubeGeometry(pulmoBranchCurveL, 16, 0.18, 16, false), pulmoMat));
    heartRoot.add(new THREE.Mesh(new THREE.TubeGeometry(pulmoBranchCurveR, 16, 0.18, 16, false), pulmoMat));

    // Superior Vena Cava
    const svcGeom = new THREE.CylinderGeometry(0.24, 0.24, 1.1, 20);
    const svcMesh = new THREE.Mesh(svcGeom, pulmoMat);
    svcMesh.position.set(-0.95, 1.6, -0.2);
    heartRoot.add(svcMesh);

    // =========================================================================
    // DEDICATED CORONARY ARTERY VESSELS: LAD, LCX, RCA
    // =========================================================================
    const vesselMeshes = {};
    const vesselGroups = {};
    const raycastTargets = [];

    // Helper to create an artery tube group
    function createArteryGroup(vesselKey, mainCurvePoints, branchCurves, radius) {
      const risk = window.CARDIO_DATA[vesselKey].risk;
      const colorHex = getRiskColorHex(risk);

      const mat = new THREE.MeshStandardMaterial({
        color: colorHex,
        emissive: colorHex,
        emissiveIntensity: 0.42,
        roughness: 0.3,
        metalness: 0.25
      });

      const group = new THREE.Group();
      group.name = "vessel_" + vesselKey;

      // Main trunk
      const curve = new THREE.CatmullRomCurve3(mainCurvePoints);
      const geom = new THREE.TubeGeometry(curve, 50, radius, 18, false);
      const mesh = new THREE.Mesh(geom, mat);
      mesh.userData = { vesselKey: vesselKey };
      group.add(mesh);
      raycastTargets.push(mesh);

      // Arterial branches
      if (branchCurves && branchCurves.length > 0) {
        branchCurves.forEach(bPts => {
          const bCurve = new THREE.CatmullRomCurve3(bPts);
          const bGeom = new THREE.TubeGeometry(bCurve, 20, radius * 0.65, 12, false);
          const bMesh = new THREE.Mesh(bGeom, mat);
          bMesh.userData = { vesselKey: vesselKey };
          group.add(bMesh);
          raycastTargets.push(bMesh);
        });
      }

      heartRoot.add(group);
      vesselGroups[vesselKey] = group;
      vesselMeshes[vesselKey] = { material: mat, colorHex: colorHex };
      return group;
    }

    // 1. LAD: Left Anterior Descending Artery
    // Originates behind pulmonary trunk near left aortic sinus,
    // descends along the anterior interventricular groove to the apex.
    const ladMainPoints = [
      new THREE.Vector3(0.08, 0.72, 0.4),
      new THREE.Vector3(0.18, 0.5, 0.85),
      new THREE.Vector3(0.25, 0.1, 1.25),
      new THREE.Vector3(0.2, -0.4, 1.42),
      new THREE.Vector3(0.05, -0.9, 1.35),
      new THREE.Vector3(-0.15, -1.35, 1.05),
      new THREE.Vector3(-0.35, -1.75, 0.5) // Reaches cardiac apex
    ];
    const ladBranches = [
      // Diagonal Branch 1 (D1) lateral across anterior LV wall
      [
        new THREE.Vector3(0.22, 0.25, 1.15),
        new THREE.Vector3(0.65, 0.05, 1.15),
        new THREE.Vector3(0.95, -0.3, 0.85)
      ],
      // Diagonal Branch 2 (D2)
      [
        new THREE.Vector3(0.15, -0.55, 1.38),
        new THREE.Vector3(0.5, -0.75, 1.15),
        new THREE.Vector3(0.72, -1.1, 0.7)
      ],
      // Septal Perforator Branch (S1)
      [
        new THREE.Vector3(0.22, 0.35, 1.05),
        new THREE.Vector3(0.05, 0.2, 0.75),
        new THREE.Vector3(-0.05, 0.0, 0.5)
      ]
    ];
    createArteryGroup("LAD", ladMainPoints, ladBranches, 0.095);

    // 2. LCX: Left Circumflex Artery
    // Branches from left main, curves laterally around left AV groove to posterior surface.
    const lcxMainPoints = [
      new THREE.Vector3(0.08, 0.72, 0.4),
      new THREE.Vector3(0.5, 0.65, 0.45),
      new THREE.Vector3(0.98, 0.52, 0.25),
      new THREE.Vector3(1.32, 0.32, -0.15),
      new THREE.Vector3(1.3, -0.05, -0.65),
      new THREE.Vector3(0.95, -0.45, -0.98),
      new THREE.Vector3(0.55, -0.85, -1.05)
    ];
    const lcxBranches = [
      // Obtuse Marginal 1 (OM1) descending down lateral wall
      [
        new THREE.Vector3(1.18, 0.42, 0.05),
        new THREE.Vector3(1.35, 0.0, 0.35),
        new THREE.Vector3(1.3, -0.5, 0.45),
        new THREE.Vector3(1.05, -1.0, 0.35)
      ],
      // Obtuse Marginal 2 (OM2)
      [
        new THREE.Vector3(1.22, -0.15, -0.7),
        new THREE.Vector3(1.15, -0.6, -0.4),
        new THREE.Vector3(0.85, -1.1, -0.2)
      ]
    ];
    createArteryGroup("LCX", lcxMainPoints, lcxBranches, 0.088);

    // 3. RCA: Right Coronary Artery
    // Arises from right aortic sinus, descends down right AV groove toward crux.
    const rcaMainPoints = [
      new THREE.Vector3(-0.15, 0.75, 0.35),
      new THREE.Vector3(-0.55, 0.65, 0.55),
      new THREE.Vector3(-0.95, 0.45, 0.65),
      new THREE.Vector3(-1.3, 0.05, 0.55),
      new THREE.Vector3(-1.35, -0.45, 0.3),
      new THREE.Vector3(-1.25, -0.95, -0.15),
      new THREE.Vector3(-0.9, -1.25, -0.55),
      new THREE.Vector3(-0.35, -1.45, -0.75) // Posterior descending terminal
    ];
    const rcaBranches = [
      // Conus branch (superior)
      [
        new THREE.Vector3(-0.4, 0.7, 0.45),
        new THREE.Vector3(-0.3, 0.85, 0.7),
        new THREE.Vector3(-0.1, 0.9, 0.85)
      ],
      // Acute Marginal Branch (AM) along inferior right ventricular border
      [
        new THREE.Vector3(-1.35, -0.4, 0.35),
        new THREE.Vector3(-1.15, -0.65, 0.75),
        new THREE.Vector3(-0.8, -0.95, 0.95),
        new THREE.Vector3(-0.5, -1.3, 0.8)
      ],
      // Posterior Descending Artery (PDA)
      [
        new THREE.Vector3(-0.45, -1.42, -0.7),
        new THREE.Vector3(-0.35, -1.6, -0.35),
        new THREE.Vector3(-0.3, -1.72, 0.1)
      ]
    ];
    createArteryGroup("RCA", rcaMainPoints, rcaBranches, 0.092);

    // =========================================================================
    // UPDATE BUTTONS & UI WITH PYTHON PREDICTIONS
    // =========================================================================
    function updateTelemetryAndUI() {
      ['LAD', 'LCX', 'RCA'].forEach(key => {
        const item = window.CARDIO_DATA[key];
        const colorCss = getRiskColorCss(item.risk);
        const pillElem = document.getElementById("pill-" + key.toLowerCase());
        const dotElem = document.getElementById("dot-" + key.toLowerCase());
        if (pillElem) {
          pillElem.innerText = item.risk.toFixed(1) + "%";
          pillElem.style.color = colorCss;
        }
        if (dotElem) {
          dotElem.style.background = colorCss;
          dotElem.style.boxShadow = "0 0 8px " + colorCss;
        }
      });
    }
    updateTelemetryAndUI();

    // Default selection: LAD
    let selectedVesselKey = "LAD";
    selectVessel("LAD");

    // =========================================================================
    // INTERACTION & SELECTION LOGIC
    // =========================================================================
    function selectVessel(vesselKey) {
      selectedVesselKey = vesselKey;
      const data = window.CARDIO_DATA[vesselKey];
      const meta = VESSEL_METADATA[vesselKey];
      const risk = data.risk;
      const colorCss = getRiskColorCss(risk);

      // Update HUD panel
      document.getElementById('telem-tag').innerText = "SELECTED VESSEL TELEMETRY";
      document.getElementById('telem-tag').style.color = colorCss;
      document.getElementById('telem-name').innerText = meta.fullName;
      document.getElementById('telem-prob').innerHTML = risk.toFixed(1) + "<span>%</span>";
      document.getElementById('telem-prob').style.color = colorCss;

      const badge = document.getElementById('telem-badge');
      badge.className = "telem-status-badge " + getRiskBadgeClass(risk);
      badge.innerText = getRiskTierText(risk, data.label);

      document.getElementById('telem-desc').innerText = meta.desc;
      document.getElementById('telem-territory').innerHTML = "<b>Perfusion Territory:</b> " + meta.territory;

      document.getElementById('telemetry-panel').style.borderColor = colorCss;

      // Update button active state
      ['LAD', 'LCX', 'RCA'].forEach(k => {
        const b = document.getElementById('btn-vessel-' + k.toLowerCase());
        if (b) {
          if (k === vesselKey) b.classList.add('active');
          else b.classList.remove('active');
        }
      });

      // Highlight 3D vessel material
      highlightVesselMaterial(vesselKey);
    }

    function highlightVesselMaterial(vesselKey) {
      ['LAD', 'LCX', 'RCA'].forEach(k => {
        const item = vesselMeshes[k];
        if (!item) return;
        if (k === vesselKey) {
          item.material.emissiveIntensity = 0.85;
          item.material.color.setHex(item.colorHex);
        } else {
          item.material.emissiveIntensity = 0.28;
        }
      });
    }

    // =========================================================================
    // RAYCASTING (HOVER & CLICK DETECTION)
    // =========================================================================
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function onPointerMove(event) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(raycastTargets);

      if (intersects.length > 0) {
        document.body.style.cursor = 'pointer';
        const hit = intersects[0].object;
        if (hit.userData && hit.userData.vesselKey) {
          const key = hit.userData.vesselKey;
          if (key !== selectedVesselKey) {
            vesselMeshes[key].material.emissiveIntensity = 0.65;
          }
        }
      } else {
        document.body.style.cursor = 'default';
        ['LAD', 'LCX', 'RCA'].forEach(k => {
          if (k !== selectedVesselKey && vesselMeshes[k]) {
            vesselMeshes[k].material.emissiveIntensity = 0.28;
          }
        });
      }
    }

    function onPointerDown(event) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(raycastTargets);

      if (intersects.length > 0) {
        const hit = intersects[0].object;
        if (hit.userData && hit.userData.vesselKey) {
          selectVessel(hit.userData.vesselKey);
        }
      }
    }

    window.addEventListener('mousemove', onPointerMove, false);
    renderer.domElement.addEventListener('pointerdown', onPointerDown, false);

    // =========================================================================
    // CAMERA VIEW PRESETS & SMOOTH TRANSITIONS
    // =========================================================================
    let targetCameraPos = null;
    let cameraTransitioning = false;

    function setCameraView(preset) {
      document.querySelectorAll('.hud-toolbar .hud-btn').forEach(b => {
        if (b.id !== 'btn-pulse') b.classList.remove('active');
      });
      const btn = document.getElementById('btn-view-' + preset);
      if (btn) btn.classList.add('active');

      switch (preset) {
        case 'anterior':
          targetCameraPos = new THREE.Vector3(0, 0.8, 7.5);
          break;
        case 'lao':
          targetCameraPos = new THREE.Vector3(5.6, 1.2, 5.0);
          break;
        case 'rao':
          targetCameraPos = new THREE.Vector3(-5.6, 1.2, 5.0);
          break;
        case 'posterior':
          targetCameraPos = new THREE.Vector3(0, 1.2, -7.5);
          break;
      }
      cameraTransitioning = true;
    }

    function resetCamera() {
      setCameraView('anterior');
      controls.target.set(0, 0.2, 0);
    }

    // Cardiac Pulse toggle
    let pulseActive = true;
    function togglePulse() {
      pulseActive = !pulseActive;
      const b = document.getElementById('btn-pulse');
      if (pulseActive) {
        b.classList.add('active');
      } else {
        b.classList.remove('active');
      }
    }
    document.getElementById('btn-pulse').classList.add('active');

    // =========================================================================
    // GLTF / GLB ARCHITECTURE HOOK
    // Supports dynamic loading of anatomical .glb assets when provided!
    // =========================================================================
    window.CardioVision3D = {
      updateProbabilities: function(newData) {
        if (newData) {
          window.CARDIO_DATA = newData;
          ['LAD', 'LCX', 'RCA'].forEach(key => {
            if (newData[key]) {
              const r = newData[key].risk;
              const colorHex = getRiskColorHex(r);
              vesselMeshes[key].colorHex = colorHex;
              vesselMeshes[key].material.color.setHex(colorHex);
              vesselMeshes[key].material.emissive.setHex(colorHex);
            }
          });
          updateTelemetryAndUI();
          selectVessel(selectedVesselKey);
        }
      },
      loadAnatomicalGLB: function(glbUrl) {
        console.log("[CardioVision 3D] Loading anatomical GLTF model from:", glbUrl);
        const loader = new THREE.GLTFLoader();
        loader.load(glbUrl, function(gltf) {
          // Hide procedural myocardium and bind coronary materials
          myocardiumGroup.visible = false;
          const importedModel = gltf.scene;
          importedModel.traverse(node => {
            if (node.isMesh) {
              const nameLower = node.name.toLowerCase();
              if (nameLower.includes("lad") || nameLower.includes("anterior")) {
                node.material = vesselMeshes["LAD"].material;
                node.userData = { vesselKey: "LAD" };
                raycastTargets.push(node);
              } else if (nameLower.includes("lcx") || nameLower.includes("circumflex")) {
                node.material = vesselMeshes["LCX"].material;
                node.userData = { vesselKey: "LCX" };
                raycastTargets.push(node);
              } else if (nameLower.includes("rca") || nameLower.includes("right")) {
                node.material = vesselMeshes["RCA"].material;
                node.userData = { vesselKey: "RCA" };
                raycastTargets.push(node);
              }
            }
          });
          heartRoot.add(importedModel);
          console.log("[CardioVision 3D] Anatomical GLTF integrated successfully!");
        }, undefined, function(err) {
          console.error("[CardioVision 3D] Error loading GLB:", err);
        });
      }
    };

    // =========================================================================
    // ANIMATION & RENDER LOOP
    // =========================================================================
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Cardiac rhythm pulse animation (subtle systole/diastole ~70 bpm)
      if (pulseActive) {
        const beatRate = 4.4; // ~70 beats per minute
        const pulse = Math.sin(elapsedTime * beatRate);
        const beat = Math.pow(Math.max(0, pulse), 3) * 0.038;
        const scale = 1.0 + beat;
        myocardiumGroup.scale.set(scale, scale * 1.01, scale);
      } else {
        myocardiumGroup.scale.set(1.0, 1.0, 1.0);
      }

      // Smooth camera transition if preset clicked
      if (cameraTransitioning && targetCameraPos) {
        camera.position.lerp(targetCameraPos, 0.075);
        if (camera.position.distanceTo(targetCameraPos) < 0.05) {
          camera.position.copy(targetCameraPos);
          cameraTransitioning = false;
        }
      }

      // Gentle subtle rotation when idle
      if (!cameraTransitioning && !controls.state == -1) {
        heartRoot.rotation.y += 0.0012;
      }

      // Pulsing emissive glow for selected vessel
      if (selectedVesselKey && vesselMeshes[selectedVesselKey]) {
        const glowPulse = 0.5 + 0.35 * Math.sin(elapsedTime * 3.5);
        vesselMeshes[selectedVesselKey].material.emissiveIntensity = glowPulse;
      }

      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    // Responsive Canvas Resize
    function handleResize() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    }
    window.addEventListener('resize', handleResize);

    // Initial check after 200ms
    setTimeout(handleResize, 200);
  </script>
</body>
</html>
